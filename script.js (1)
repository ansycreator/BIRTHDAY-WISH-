// 🎉 Countdown → Celebration
function startCelebration() {
    const celebration = document.getElementById("celebration");

    if (celebration) {
        celebration.style.display = "flex";
    }

    // Celebration থাকবে 4 seconds
    setTimeout(() => {
        if (celebration) {
            celebration.style.display = "none";
        }
    }, 4000);
}
// 🎉 Long Falling Birthday Celebration

function startFallingCelebration() {
    const symbols = ["🎇", "🎉", "✨", "💫", "🎊", "💖"];

    const container = document.createElement("div");
    container.className = "falling-celebration";
    document.body.appendChild(container);

    function createFallingItem() {
        const item = document.createElement("span");

        item.textContent =
            symbols[Math.floor(Math.random() * symbols.length)];

        item.style.left = Math.random() * 100 + "vw";

        item.style.animationDuration =
            (5 + Math.random() * 4) + "s";

        item.style.fontSize =
            (18 + Math.random() * 12) + "px";

        container.appendChild(item);

        setTimeout(() => {
            item.remove();
        }, 10000);
    }

    // Start gently
    for (let i = 0; i < 10; i++) {
        setTimeout(createFallingItem, i * 300);
    }

    // Keep falling continuously
    const fallingInterval =
        setInterval(createFallingItem, 650);

    // 🎉 Continue for 60 seconds
    setTimeout(() => {
        clearInterval(fallingInterval);

        // Let the remaining symbols finish falling
        setTimeout(() => {
            container.remove();
        }, 10000);

    }, 60000);
